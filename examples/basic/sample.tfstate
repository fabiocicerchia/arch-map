{
  "version": 4,
  "resources": [
    {
      "type": "aws_db_instance",
      "name": "primary",
      "instances": [{ "attributes": { "id": "prod-db" } }]
    },
    {
      "type": "aws_s3_bucket",
      "name": "assets",
      "instances": [{ "attributes": { "id": "prod-assets" } }]
    },
    {
      "type": "aws_sqs_queue",
      "name": "jobs",
      "instances": [{ "attributes": { "id": "prod-jobs" } }]
    }
  ]
}
